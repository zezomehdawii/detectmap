# Postgres
POSTGRES_USER=detectmap
POSTGRES_PASSWORD=detectmap
POSTGRES_DB=detectmap
DATABASE_URL=postgresql+asyncpg://detectmap:detectmap@db:5432/detectmap
DATABASE_URL_SYNC=postgresql+psycopg2://detectmap:detectmap@db:5432/detectmap

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT — two separate secrets per the spec
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_TENANT_SECRET=change-me-tenant-secret-very-long-random-string
JWT_SUPERADMIN_SECRET=change-me-superadmin-secret-very-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=14

# Fernet key for encrypting connector secrets
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-44-char-urlsafe-base64-fernet-key=

# Internal bootstrap endpoints
INTERNAL_API_KEY=change-me-internal-api-key

# App
APP_ENV=development
APP_DEBUG=true
APP_NAME=The Detection Map
CORS_ORIGINS=http://localhost:3000

# Sign-in page hint. These are only displayed while an administrator leaves
# the hint enabled under Settings -> Branding; rotate the password and hide
# the hint before exposing the instance publicly.
DEFAULT_LOGIN_EMAIL=admin@demo.local
DEFAULT_LOGIN_PASSWORD=change-me

# ATT&CK STIX ingest (optional — defaults shown)
# ATTACK_STIX_BASE_URL=https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master
# ATTACK_STIX_FETCH_TIMEOUT=60

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000
